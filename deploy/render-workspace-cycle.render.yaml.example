# Example only: keep this private cron service separate from the public web service.
# Render cron schedules use UTC. 03:30 UTC on Sunday, Wednesday, and Friday is 09:00 IST.
services:
  - type: cron
    name: brief-workspace-cycle
    runtime: node
    schedule: "30 3 * * 0,3,5"
    buildCommand: pnpm install --frozen-lockfile && pnpm build
    startCommand: pnpm refresh:workspace
    envVars:
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_SERVICE_ROLE_KEY
        sync: false
      - key: GEMINI_API_KEY
        sync: false
      - key: GEMINI_MODEL
        value: gemini-2.5-flash-lite
      - key: OPENROUTER_API_KEY
        sync: false
      - key: OPENROUTER_MODEL
        value: nvidia/nemotron-3.5-super-vl:free
      - key: GROQ_API_KEY
        sync: false
      - key: GROQ_MODEL
        value: llama-3.3-70b-versatile
      - key: WORKER_ID
        value: brief-workspace-cycle
