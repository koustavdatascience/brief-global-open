# Example only: keep this private cron service separate from the public web service.
# Render cron schedules use UTC. 03:30 UTC on Sunday and Wednesday is 09:00 IST.
services:
  - type: cron
    name: brief-workspace-cycle
    runtime: node
    schedule: "30 3 * * 0,3"
    buildCommand: pnpm install --frozen-lockfile && pnpm build
    startCommand: pnpm refresh:workspace
    envVars:
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_SERVICE_ROLE_KEY
        sync: false
      - key: GEMINI_API_KEY
        sync: false
      - key: GEMINI_MODEL
        value: gemini-2.5-flash
      - key: OPENROUTER_API_KEY
        sync: false
      - key: OPENROUTER_MODEL
        value: openai/gpt-oss-20b
      - key: GROQ_API_KEY
        sync: false
      - key: WORKER_ID
        value: brief-workspace-cycle
